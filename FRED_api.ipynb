   "outputs": [],
   "source": [
    "interest_rate = requests.get(\n",
    "    \"https://api.stlouisfed.org/fred/series/search\",\n",
    "    params={\"search_text\": \"DFF\", \"api_key\": fred_api_key, \"file_type\": \"json\"},\n",
    "    timeout=30\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
