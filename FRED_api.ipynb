   },
   "outputs": [],
   "source": [
    "start = date(2020, 1, 1)\n",
    "end = date.today()\n",
    "\n",
    "\n",
    "ir_upper_limit_obs = requests.get(\n",
    "    \"https://api.stlouisfed.org/fred/series/observations\",\n",
    "      params={\n",
    "            \"series_id\": \"DFEDTARL\",\n",
    "            \"api_key\": fred_api_key,\n",
    "            \"file_type\": \"json\",\n",
    "            \"observation_start\": start,\n",
    "            \"observation_end\": end\n",
    "        },\n",
    "    timeout=30\n",
    ")\n",
    "\n",
    "ir_upper_limit_obs_json = ir_upper_limit_obs.json()\n",
    "\n",
    "ir_upper_limit_obs_count = ir_upper_limit_obs_json[\"count\"]\n",
    "ir_upper_limit_obs_limit = ir_upper_limit_obs_json[\"limit\"]\n",
    "\n",
    "ir_upper_limit_obs_df = pd.DataFrame(ir_upper_limit_obs_json[\"observations\"])\n",
    "\n",
    "print(f\"count: {ir_upper_limit_obs_count}\")\n",
    "print(f\"limit: {ir_upper_limit_obs_limit}\" )\n",
    "print(ir_upper_limit_obs_df[\"value\"].max())\n",
    "print(ir_upper_limit_obs_df[\"value\"].min())\n",
    "ir_upper_limit_obs_df.head(5)\n",
    "\n",
    "\n"
   ]
  },
