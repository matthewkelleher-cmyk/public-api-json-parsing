   },
   "outputs": [],
   "source": [
    "interest_rate_json = interest_rate.json()\n",
    "\n",
    "interest_count = interest_rate_json[\"count\"]\n",
    "interest_limit = interest_rate_json[\"limit\"]\n",
    "\n",
    "df_interest_rate = pd.DataFrame(interest_rate_json[\"seriess\"])\n",
    "\n",
    "print(f\"count: {interest_count}\")\n",
    "print(f\"limit: {interest_limit}\" )\n",
    "\n",
    "df_interest_rate\n"
   ]
